APP_ENV=dev
APP_TIMEZONE=Asia/Seoul
API_BASE_PATH=/kakao
API_BASE_URL=http://127.0.0.1:8000/kakao
SQLITE_PATH=./bot.db
SCHEDULER_RECENT_MISFIRE_GRACE_SECONDS=900

# LLM / shared app keys
OPENAI_API_KEY=replace_me
GEMINI_API_KEY=replace_me
# Legacy fallback for some Gemini/OpenAI client paths. Prefer GEMINI_API_KEY.
GOOGLE_API_KEY=replace_me

# HanAll official API collectors
SEC_API_KEY=replace_me
OPENDART_API_KEY=replace_me
OPENFDA_API_KEY=replace_me
DATA_GO_KR_API_KEY=replace_me
NCBI_API_KEY=replace_me
# NCBI requests should include a stable tool name and contact email.
NCBI_TOOL_NAME=replace_with_app_name
NCBI_EMAIL=replace_with_contact_email@example.com

# Polling-only delivery
KAKAO_PACKAGE_NAME=com.kakao.talk

# Deprecated socket transport settings. polling_outbox is the only supported delivery path.
PHONE_SOCKET_ENABLED=false
# PHONE_SOCKET_PACKAGE_NAME is a deprecated alias for KAKAO_PACKAGE_NAME.
# PHONE_SOCKET_HOST=192.168.0.12
# PHONE_SOCKET_PORT=9510

# HanAll LLM tuning
LLM_MODEL_HANALL_NEWS_BRIEF=gemini-3-flash-preview
LLM_TEMPERATURE_HANALL_NEWS_BRIEF=0.2
HANALL_NEWS_MAX_OUTPUT_TOKENS=3200
HANALL_NEWS_TRUNCATE_LIMIT=2400

# Request timeouts
OPENAI_TIMEOUT_SECONDS=60
OPENAI_POLL_TIMEOUT_SECONDS=600
GEMINI_TIMEOUT_SECONDS=60

# Source enable/disable and RSS feed registry live in:
#   server/hanall_sources.yaml
# Example:
#   collectors.sec_api.enabled: true|false
#   collectors.mfds.enabled: false
#   collectors.mfds.services.drug_safe_letter: false
#   rss.feeds[*].enabled: true|false
