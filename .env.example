APP_ENV=development
APP_NAME=kakao-bot-mvp
APP_TIMEZONE=Asia/Seoul
APP_BASE_URL=http://192.168.0.10:8000

DATABASE_URL=sqlite:///./data/kakao_bot.db
SQLITE_BUSY_RETRY_COUNT=3
SQLITE_BUSY_RETRY_DELAY_SECONDS=0.15

LOG_LEVEL=INFO

# Replace these before startup. Placeholder values are rejected at runtime.
INBOUND_BOT_SECRET=change-me

SMARTPHONE_HOST=192.168.0.12
SMARTPHONE_SOCKET_PORT=9500
MESSENGERBOT_BOT_NAME=change-me-bot
MB_SOCKET_CONTROL_AUTHOR_NAME=__FASTAPI__
MB_SOCKET_CONTROL_ROOM_NAME=__MB_SOCKET_CONTROL__
SOCKET_SHARED_TOKEN=change-me-too
SOCKET_CONNECT_TIMEOUT_SECONDS=5
SOCKET_MAX_RETRIES=3
SOCKET_RETRY_BACKOFF_SECONDS=1

MESSAGE_CHUNK_LIMIT=900
ADMIN_ROOM_NAME=김휘태
DEFAULT_PACKAGE_NAME=com.kakao.talk

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_YOUTUBE_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.5
KIMI_FORMULA_URIS=moonshot/date:latest,moonshot/web-search:latest
KIMI_TOOL_TIMEOUT_SECONDS=25
KIMI_MAX_ITERATIONS=5
KIMI_OVERALL_DEADLINE_SECONDS=120

WEATHER_API_KEY=
WEATHER_GRID_X=95
WEATHER_GRID_Y=77
KMA_TIMEOUT_SECONDS=10
KMA_BASE_SLOTS=2300,0200,0500,0800,1100,1400,1700,2000

CHILD_BIRTH_DATE=2024-09-26

ROOM_CONFIG_PATH=config/rooms.yaml
PROMPT_CONFIG_PATH=config/prompts.yaml
